{
  "name": "delivery-hub",
  "version": "0.5.9.1",
  "description": "Delivery Hub V0.5.9.1 - preenchimento direto iMile para teste.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "build:local": "tsc -p tsconfig.json && vite build --mode localserver",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run validate && npm run test && npm run build",
    "planilhas:validar": "node scripts/node/validar-planilhas.mjs",
    "serve:shared": "node scripts/node/servidor-local-compartilhado.mjs",
    "local:shared": "npm run build:local && npm run serve:shared",
    "firebase:emulators": "firebase emulators:start --config firebase.json",
    "android:configurar": "node scripts/node/aplicar-queries-android.mjs && node scripts/node/aplicar-native-bridge-android.mjs",
    "atualizacao:preparar": "node scripts/node/preparar-manifesto-atualizacao.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "fast-xml-parser": "^5.3.8",
    "firebase-tools": "^15.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
