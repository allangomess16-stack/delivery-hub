{
  "name": "delivery-hub",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run validate && npm run test && npm run build",
    "planilhas:validar": "node scripts/node/validar-planilhas.mjs",
    "serve:shared": "node scripts/node/servidor-local-compartilhado.mjs",
    "local:shared": "npm run build && npm run serve:shared",
    "firebase:emulators": "firebase emulators:start --config firebase/firebase.json"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "xlsx": "^0.18.5",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "firebase-tools": "^15.28.2"
  }
}
